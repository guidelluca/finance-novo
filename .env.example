# Copie para .env e preencha com os valores do Supabase (Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- IA (local: .env | produção: variáveis no painel do host no momento do BUILD, ex. Vercel "Production") ---
# Sem isto no build de produção, o bundle fica sem chaves — a IA só funciona em dev.
#
# Opcional: Google AI Studio — tier gratuito para dicas, categorização
# e extração de transações a partir de PRINTS (visão multimodal).
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Opcional (por omissão: gemini-2.0-flash)
# VITE_GEMINI_MODEL=gemini-2.0-flash
# Opcional: modelo específico para import por print (fallback usa VITE_GEMINI_MODEL)
# VITE_GEMINI_VISION_MODEL=gemini-2.0-flash

# Opcional: Groq — fallback se Gemini falhar (quota, chave inválida, etc.)
# https://console.groq.com/keys
VITE_GROQ_API_KEY=
# Opcional: ordem do LLM — gemini-first (omissão), groq-first, ou groq-only (sem Gemini de todo)
# VITE_FINANCE_LLM_ORDER=groq-first
# VITE_FINANCE_LLM_ORDER=groq-only
# Opcional (omissão: llama-3.1-8b-instant — melhor TPM no free tier; 70b esgota rápido)
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Opcional: IA via Supabase Edge Function (recomendado em produção — chaves só em Secrets, não no JS público)
# 1) supabase secrets set GEMINI_API_KEY=...  (e/ou GROQ_API_KEY=...)
# 2) supabase functions deploy finance-llm
# 3) No host do PWA (Vercel etc.), define só:
# VITE_FINANCE_LLM_VIA_EDGE=true
# Opcional nos secrets da função: GEMINI_MODEL, GROQ_MODEL, FINANCE_LLM_ORDER=groq-first

# Importação de prints: por padrão a leitura é LOCAL (Tesseract.js no navegador) — grátis e ilimitada.
# Com a chave Gemini/Groq configurada, aparece também a opção "Usar IA" (consome a cota gratuita).
